<Window x:Class="AngryMouse.CursorRoleAdjustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AngryMouse"
        Title="Adjust Cursor"
        Icon="{x:Static local:AppIcon.ImageSource}"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DrawingBrush x:Key="PreviewCheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource Theme.PreviewCheckerBaseBrush}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource Theme.PreviewCheckerAltBrush}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Name="RoleTextBlock"
            Grid.Row="0"
            FontWeight="Bold"
            Margin="0,0,0,8" />

        <Border
            Grid.Row="1"
            MinHeight="460"
            BorderBrush="{DynamicResource Theme.BorderBrush}"
            BorderThickness="1"
            Background="{StaticResource PreviewCheckerBrush}"
            Margin="0,0,0,8"
            ClipToBounds="True">
            <Canvas
                Name="PreviewCanvas"
                Background="Transparent"
                ClipToBounds="True"
                SizeChanged="PreviewCanvas_OnSizeChanged">
                <Image
                    Name="SystemCursorImage"
                    Panel.ZIndex="1"
                    Stretch="None"
                    Opacity="0.45"
                    IsHitTestVisible="False"
                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Image
                    Name="PreviewImage"
                    Panel.ZIndex="2"
                    Cursor="SizeAll"
                    Stretch="None"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    MouseLeftButtonDown="PreviewImage_OnMouseLeftButtonDown"
                    MouseLeftButtonUp="PreviewImage_OnMouseLeftButtonUp"
                    MouseMove="PreviewImage_OnMouseMove"
                    LostMouseCapture="PreviewImage_OnLostMouseCapture" />

                <Line
                    Name="TargetHorizontal"
                    Panel.ZIndex="3"
                    Stroke="{DynamicResource Theme.AccentRedBrush}"
                    StrokeThickness="1.5"
                    StrokeDashArray="4 3"
                    IsHitTestVisible="False" />
                <Line
                    Name="TargetVertical"
                    Panel.ZIndex="3"
                    Stroke="{DynamicResource Theme.AccentRedBrush}"
                    StrokeThickness="1.5"
                    StrokeDashArray="4 3"
                    IsHitTestVisible="False" />
                <Ellipse
                    Name="TargetDot"
                    Panel.ZIndex="3"
                    Width="12"
                    Height="12"
                    Fill="{DynamicResource Theme.AccentRedBrush}"
                    Stroke="{DynamicResource Theme.WindowBackgroundBrush}"
                    StrokeThickness="1"
                    IsHitTestVisible="False" />
            </Canvas>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Rectangle Width="16" Height="3" Fill="{DynamicResource Theme.SecondaryForegroundBrush}" Opacity="0.45" Margin="0,8,6,0" />
            <TextBlock Text="Windows cursor" Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" Margin="0,0,18,0" />
            <Rectangle Width="16" Height="3" Fill="{DynamicResource Theme.ControlForegroundBrush}" Margin="0,8,6,0" />
            <TextBlock Text="PNG cursor" Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" Margin="0,0,18,0" />
            <Ellipse Width="10" Height="10" Fill="{DynamicResource Theme.AccentRedBrush}" Stroke="{DynamicResource Theme.WindowBackgroundBrush}" StrokeThickness="1" Margin="0,4,6,0" />
            <TextBlock Text="Mouse point" Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Hotspot X offset" Margin="2" />
            <TextBox
                Name="HotspotOffsetXTextBox"
                Grid.Column="1"
                Grid.Row="0"
                Margin="2"
                TextChanged="HotspotOffset_OnChanged" />

            <Label Grid.Column="2" Grid.Row="0" Content="Hotspot Y offset" Margin="12,2,2,2" />
            <TextBox
                Name="HotspotOffsetYTextBox"
                Grid.Column="3"
                Grid.Row="0"
                Margin="2"
                TextChanged="HotspotOffset_OnChanged" />

            <CheckBox
                Name="TrimTransparentPaddingCheckBox"
                Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="4"
                Margin="2,8,2,2"
                Content="Trim transparent padding"
                Checked="TrimTransparentPadding_OnChanged"
                Unchecked="TrimTransparentPadding_OnChanged" />
        </Grid>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="4"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Theme.SecondaryForegroundBrush}"
            Margin="0,0,0,8" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Content="_Reset"
                Width="70"
                Margin="0,0,6,0"
                Click="ResetButton_OnClick" />
            <Button
                Content="_Cancel"
                Width="70"
                Margin="0,0,6,0"
                IsCancel="True" />
            <Button
                Content="_Save"
                Width="70"
                IsDefault="True"
                Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
