<Window x:Class="AngryMouse.CursorRoleAdjustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust Cursor"
        Width="640"
        Height="560"
        MinWidth="560"
        MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DrawingBrush x:Key="PreviewCheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource Theme.PreviewCheckerBaseBrush}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource Theme.PreviewCheckerAltBrush}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Name="RoleTextBlock"
            Grid.Row="0"
            FontWeight="Bold"
            Margin="0,0,0,8" />

        <Border
            Grid.Row="1"
            MinHeight="300"
            BorderBrush="{DynamicResource Theme.BorderBrush}"
            BorderThickness="1"
            Background="{StaticResource PreviewCheckerBrush}"
            Margin="0,0,0,8"
            ClipToBounds="True">
            <Viewbox Stretch="Uniform">
                <Canvas
                    Name="PreviewCanvas"
                    Width="560"
                    Height="320"
                    ClipToBounds="True">
                    <Image
                        Name="ReferenceImage"
                        Stretch="None"
                        Opacity="0.28"
                        RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image
                        Name="PreviewImage"
                        Stretch="None"
                        RenderOptions.BitmapScalingMode="NearestNeighbor" />

                    <Line Name="DefaultHotspotHorizontal" Stroke="{DynamicResource Theme.AccentBlueBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                    <Line Name="DefaultHotspotVertical" Stroke="{DynamicResource Theme.AccentBlueBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                    <Ellipse Name="DefaultHotspotDot" Width="10" Height="10" Fill="{DynamicResource Theme.AccentBlueBrush}" Stroke="{DynamicResource Theme.WindowBackgroundBrush}" StrokeThickness="1" />

                    <Line Name="AdjustedHotspotHorizontal" Stroke="{DynamicResource Theme.AccentRedBrush}" StrokeThickness="1.8" />
                    <Line Name="AdjustedHotspotVertical" Stroke="{DynamicResource Theme.AccentRedBrush}" StrokeThickness="1.8" />
                    <Ellipse Name="AdjustedHotspotDot" Width="12" Height="12" Fill="{DynamicResource Theme.AccentRedBrush}" Stroke="{DynamicResource Theme.WindowBackgroundBrush}" StrokeThickness="1" />
                </Canvas>
            </Viewbox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Rectangle Width="16" Height="3" Fill="{DynamicResource Theme.AccentBlueBrush}" Margin="0,8,6,0" />
            <TextBlock Text="Normal hotspot" Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" Margin="0,0,18,0" />
            <Rectangle Width="16" Height="3" Fill="{DynamicResource Theme.AccentRedBrush}" Margin="0,8,6,0" />
            <TextBlock Text="Adjusted hotspot" Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Hotspot X offset" Margin="2" />
            <TextBox
                Name="HotspotOffsetXTextBox"
                Grid.Column="1"
                Grid.Row="0"
                Margin="2"
                TextChanged="HotspotOffset_OnChanged" />

            <Label Grid.Column="2" Grid.Row="0" Content="Hotspot Y offset" Margin="12,2,2,2" />
            <TextBox
                Name="HotspotOffsetYTextBox"
                Grid.Column="3"
                Grid.Row="0"
                Margin="2"
                TextChanged="HotspotOffset_OnChanged" />

            <CheckBox
                Name="TrimTransparentPaddingCheckBox"
                Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="4"
                Margin="2,8,2,2"
                Content="Trim transparent padding"
                Checked="TrimTransparentPadding_OnChanged"
                Unchecked="TrimTransparentPadding_OnChanged" />
        </Grid>

        <TextBlock
            Name="StatusTextBlock"
            Grid.Row="4"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Theme.SecondaryForegroundBrush}"
            Margin="0,0,0,8" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button
                Content="Reset"
                Width="70"
                Margin="0,0,6,0"
                Click="ResetButton_OnClick" />
            <Button
                Content="Save"
                Width="70"
                Margin="0,0,6,0"
                IsDefault="True"
                Click="SaveButton_OnClick" />
            <Button
                Content="Cancel"
                Width="70"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
