<Window x:Class="AngryMouse.SettingsWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:AngryMouse"
mc:Ignorable="d"
Title="Settings"
Icon="{x:Static local:AppIcon.ImageSource}"
Width="980"
Height="720"
MinWidth="860"
MinHeight="600"
ResizeMode="CanResizeWithGrip"
Loaded="Window_Loaded"
Closed="Window_Closed">
<Grid Margin="18" Background="{DynamicResource Theme.WindowBackgroundBrush}">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>

<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
<CheckBox
Name="StartMinimizedToTrayCheckBox"
Content="_Start minimized to tray"
VerticalAlignment="Center"
Margin="0,0,16,0"
Checked="StartMinimizedToTrayCheckBox_OnChanged"
Unchecked="StartMinimizedToTrayCheckBox_OnChanged" />
<TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0" />
<CheckBox
Name="DarkModeCheckBox"
Content="_Dark mode"
VerticalAlignment="Center"
Checked="DarkModeCheckBox_OnChanged"
Unchecked="DarkModeCheckBox_OnChanged" />
</StackPanel>

<GroupBox Grid.Row="1" Margin="0,0,0,8">
<GroupBox.Header>
<DockPanel LastChildFill="False">
<TextBlock Text="Cursor" VerticalAlignment="Center" />
<Button
Content="_Reset"
Margin="12,0,0,0"
Padding="6,1"
Click="ResetCursorSettingsButton_OnClick" />
</DockPanel>
</GroupBox.Header>
<Grid Margin="8">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="130" />
<ColumnDefinition Width="270" />
<ColumnDefinition Width="110" />
<ColumnDefinition Width="110" />
<ColumnDefinition Width="110" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>

<Label Grid.Column="0" Grid.Row="0" Content="Zoom cursor" Margin="2" />
<ComboBox
Name="CursorSourceComboBox"
Grid.Column="1"
Grid.Row="0"
Width="260"
HorizontalAlignment="Left"
Margin="2"
SelectionChanged="CursorSourceComboBox_OnSelectionChanged">
<ComboBoxItem
Content="Cursor collection"
Tag="Collection">
<ComboBoxItem.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Use high-resolution PNG cursor collections instead of zooming the current low-pixel Windows cursor."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</ComboBoxItem.ToolTip>
</ComboBoxItem>
<ComboBoxItem Content="Active Windows cursor" Tag="System">
<ComboBoxItem.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Zoom the current Windows cursor. Lower quality but always available without importing PNG files."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</ComboBoxItem.ToolTip>
</ComboBoxItem>
</ComboBox>

<Label Name="CollectionLabel" Grid.Column="0" Grid.Row="1" Content="Collection" Margin="2" />
<WrapPanel
Name="CollectionToolbarPanel"
Grid.Column="1"
Grid.Row="1"
Grid.ColumnSpan="5"
Margin="2,0,2,4"
VerticalAlignment="Center">
<ComboBox
Name="CollectionComboBox"
Width="220"
Margin="0,2,4,2"
SelectionChanged="CollectionComboBox_OnSelectionChanged" />
<Button
Name="ImportCollectionButton"
Content="_Import folder"
Margin="2"
Padding="8,2"
Click="ImportCollectionButton_OnClick">
<Button.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Import a folder containing PNG cursor files as a new cursor collection."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Button.ToolTip>
</Button>
<Button
Name="ImportSettingsButton"
Content="Import _zip"
Margin="2"
Padding="8,2"
Click="ImportSettingsButton_OnClick">
<Button.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Import a ZIP package exported from another AngryMouse installation. Contains settings.xml and optionally cursor collection folders."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Button.ToolTip>
</Button>
<Button
Name="ExportSettingsButton"
Content="_Export zip"
Margin="2"
Padding="8,2"
Click="ExportSettingsButton_OnClick">
<Button.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Export current application settings and optionally cursor collections to a ZIP file. Can be imported on another AngryMouse installation."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Button.ToolTip>
</Button>
<Border Width="1" Height="22" Margin="8,2,8,2" Background="{DynamicResource Theme.BorderBrush}" />
<ComboBox
Name="RemoveCollectionComboBox"
Width="180"
Margin="0,2,4,2"
SelectionChanged="RemoveCollectionComboBox_OnSelectionChanged">
<ComboBox.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Choose an imported cursor collection to remove."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</ComboBox.ToolTip>
</ComboBox>
<Button
Name="RemoveCollectionButton"
Content="_Remove"
Margin="2"
Padding="8,2"
Click="RemoveCollectionButton_OnClick" />
</WrapPanel>

<CheckBox
Name="IncludeCollectionsCheckBox"
Grid.Column="1"
Grid.Row="2"
Grid.ColumnSpan="5"
Content="_Package cursor collections with settings zip"
VerticalAlignment="Center"
Margin="2,0,2,8">
<CheckBox.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="When checked, imported/exported ZIP packages include cursor collections. When unchecked, only application settings are loaded or saved."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</CheckBox.ToolTip>
</CheckBox>

<TextBlock
Name="CursorStatusTextBlock"
Grid.Column="0"
Grid.Row="3"
Grid.ColumnSpan="6"
Margin="2,4,2,8"
TextWrapping="Wrap" />

<StackPanel
Name="CursorRenderPanel"
Grid.Column="0"
Grid.Row="4"
Grid.ColumnSpan="6"
Margin="2,0,2,8">
<ProgressBar
Name="CursorRenderProgressBar"
Height="14"
Visibility="Collapsed" />
<TextBlock
Name="CursorRenderStatusTextBlock"
Margin="0,2,0,0"
FontSize="11"
Foreground="{DynamicResource Theme.SecondaryForegroundBrush}"
Visibility="Collapsed" />
</StackPanel>

<DataGrid
Name="CursorRoleDataGrid"
Grid.Column="0"
Grid.Row="5"
Grid.ColumnSpan="6"
MinHeight="240"
Margin="2,0,2,8"
AutoGenerateColumns="False"
CanUserAddRows="False"
CanUserDeleteRows="False"
CanUserResizeRows="False"
HeadersVisibility="Column"
IsReadOnly="True"
SelectionMode="Single">
<DataGrid.Columns>
<DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="130" />
<DataGridTextColumn Header="Assigned file" Binding="{Binding AssignedFile}" Width="*" MinWidth="240" />
<DataGridTemplateColumn Header="Status" Width="90">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<TextBlock
Text="{Binding Status}"
Foreground="{Binding StatusForeground}"
VerticalAlignment="Center" />
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="Adjust" Width="85">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<Button
Content="_Adjust"
Padding="6,1"
IsEnabled="{Binding CanAdjust}"
Click="AdjustRoleButton_OnClick" />
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="Change" Width="85">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<Button
Content="_Change"
Padding="6,1"
IsEnabled="{Binding CanEditRole}"
Click="ChangeRoleButton_OnClick" />
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="Clear" Width="75">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<Button
Content="_Clear"
Padding="6,1"
IsEnabled="{Binding CanClear}"
Click="ClearRoleButton_OnClick" />
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="Zoom preview" Width="95">
<DataGridTemplateColumn.CellTemplate>
<DataTemplate>
<Border
BorderBrush="{DynamicResource Theme.BorderBrush}"
BorderThickness="1"
Padding="3"
Cursor="{Binding RoleCursor}"
IsEnabled="{Binding CanPreview}"
MouseEnter="CursorRolePreview_OnMouseEnter"
MouseLeave="CursorRolePreview_OnMouseLeave"
MouseLeftButtonDown="CursorRolePreview_OnMouseLeftButtonDown">
<Border Width="36" Height="36">
<Image Source="{Binding ZoomPreview}" Stretch="Uniform" />
</Border>
</Border>
</DataTemplate>
</DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
</DataGrid>

<Label
Grid.Column="0"
Grid.Row="6"
Content="Zoom size"
Margin="2">
<Label.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Controls how large the zoom cursor appears."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Label.ToolTip>
</Label>
<Slider
Name="SizeSlider"
Grid.Column="1"
Grid.Row="6"
Width="260"
VerticalAlignment="Center"
Minimum="2"
Maximum="10"
AutoToolTipPlacement="None"
AutoToolTipPrecision="0"
TickFrequency="1"
IsSnapToTickEnabled="True"
TickPlacement="BottomRight"
Margin="2"
ValueChanged="SizeSlider_OnValueChanged" />
<Label Name="SizeValueLabel" Grid.Column="2" Grid.Row="6"
Content="{Binding ElementName=SizeSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" Margin="2" />
<TextBlock
Grid.Column="3"
Grid.Row="6"
Text=""
Foreground="{DynamicResource Theme.AccentBlueBrush}"
Visibility="Collapsed"
VerticalAlignment="Center"
Margin="2" />

<Label
Grid.Column="0"
Grid.Row="7"
Content="Grow/shrink speed"
Margin="2">
<Label.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Controls the grow and shrink animation duration in milliseconds."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Label.ToolTip>
</Label>
<Slider
Name="AnimationLengthSlider"
Grid.Column="1"
Grid.Row="7"
Width="260"
VerticalAlignment="Center"
Minimum="0"
Maximum="1000"
AutoToolTipPlacement="None"
AutoToolTipPrecision="0"
TickFrequency="50"
IsSnapToTickEnabled="True"
TickPlacement="BottomRight"
Margin="2"
ValueChanged="AnimationLengthSlider_OnValueChanged" />
<Label Name="AnimationLengthValueLabel" Grid.Column="2" Grid.Row="7"
Content="{Binding ElementName=AnimationLengthSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" Margin="2" />
<Label Grid.Column="3" Grid.Row="7" Content="ms" Margin="2" />
<TextBlock
Grid.Column="4"
Grid.Row="7"
Text=""
Foreground="{DynamicResource Theme.AccentBlueBrush}"
Visibility="Collapsed"
VerticalAlignment="Center"
Margin="2" />

<Label
Grid.Column="0"
Grid.Row="8"
Content="Visible duration"
Margin="2">
<Label.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Controls how long the zoom cursor stays visible after a shake."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Label.ToolTip>
</Label>
<Slider
Name="VisibleDurationSlider"
Grid.Column="1"
Grid.Row="8"
Width="260"
VerticalAlignment="Center"
Minimum="100"
Maximum="3000"
AutoToolTipPlacement="None"
AutoToolTipPrecision="0"
TickFrequency="100"
IsSnapToTickEnabled="True"
TickPlacement="BottomRight"
Margin="2"
ValueChanged="VisibleDurationSlider_OnValueChanged" />
<Label Name="VisibleDurationValueLabel" Grid.Column="2" Grid.Row="8"
Content="{Binding ElementName=VisibleDurationSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" Margin="2" />
<Label Grid.Column="3" Grid.Row="8" Content="ms" Margin="2" />
<TextBlock
Grid.Column="4"
Grid.Row="8"
Text=""
Foreground="{DynamicResource Theme.AccentBlueBrush}"
Visibility="Collapsed"
VerticalAlignment="Center"
Margin="2" />

<CheckBox
Name="HideBuiltInCursorCheckBox"
Grid.Column="1"
Grid.Row="9"
Grid.ColumnSpan="5"
Content="_Hide built-in cursor while zoom cursor is visible"
Margin="2,8,2,2"
Checked="HideBuiltInCursorCheckBox_OnChanged"
Unchecked="HideBuiltInCursorCheckBox_OnChanged" />
</Grid>
</GroupBox>

<GroupBox Grid.Row="2" Margin="0,0,0,8">
<GroupBox.Header>
<DockPanel LastChildFill="False">
<TextBlock Text="Activation" VerticalAlignment="Center" />
<Button
Content="_Reset"
Margin="12,0,0,0"
Padding="6,1"
Click="ResetShakeSettingsButton_OnClick" />
</DockPanel>
</GroupBox.Header>
<TabControl Margin="8">
<TabItem Header="Shake">
<Grid Margin="8">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="130" />
<ColumnDefinition Width="260" />
<ColumnDefinition Width="50" />
<ColumnDefinition Width="Auto" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
<CheckBox
Name="ShakeActivationEnabledCheckBox"
Grid.Column="1"
Grid.Row="0"
Grid.ColumnSpan="4"
Content="_Enable shake activation"
VerticalAlignment="Center"
Margin="2,2,2,8"
Checked="ActivationSourceCheckBox_OnChanged"
Unchecked="ActivationSourceCheckBox_OnChanged" />
<Grid
Name="ShakeActivationControlsGrid"
Grid.Column="0"
Grid.Row="1"
Grid.ColumnSpan="5">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="130" />
<ColumnDefinition Width="260" />
<ColumnDefinition Width="50" />
<ColumnDefinition Width="Auto" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
<Label
Grid.Column="0"
Grid.Row="0"
Content="Shake window"
Margin="2">
<Label.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Lower reacts to shorter shakes. Higher needs a longer shake."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Label.ToolTip>
</Label>
<Slider
Name="ShakeTrackingIntervalSlider"
Grid.Column="1"
Grid.Row="0"
Width="260"
VerticalAlignment="Center"
Minimum="100"
Maximum="2000"
AutoToolTipPlacement="None"
AutoToolTipPrecision="0"
TickFrequency="50"
IsSnapToTickEnabled="True"
TickPlacement="BottomRight"
Margin="2"
ValueChanged="ShakeTrackingIntervalSlider_OnValueChanged" />
<Label Name="ShakeTrackingIntervalValueLabel" Grid.Column="2" Grid.Row="0"
Content="{Binding ElementName=ShakeTrackingIntervalSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" Margin="2" />
<Label Grid.Column="3" Grid.Row="0" Content="ms" Margin="2" />
<DockPanel
Grid.Column="4"
Grid.Row="0"
Margin="8,4,2,2">
<TextBlock
Text=""
Foreground="{DynamicResource Theme.AccentBlueBrush}"
Visibility="Collapsed"
VerticalAlignment="Top"
Margin="0,0,6,0" />
<TextBlock
Text="Lower reacts to shorter shakes. Higher needs a longer shake."
TextWrapping="Wrap"
FontSize="11"
Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />
</DockPanel>
<Label
Grid.Column="0"
Grid.Row="1"
Content="Shake speed"
Margin="2">
<Label.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Lower is easier to trigger. Higher requires faster movement."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Label.ToolTip>
</Label>
<Slider
Name="ShakeMinimumSpeedSlider"
Grid.Column="1"
Grid.Row="1"
Width="260"
VerticalAlignment="Center"
Minimum="0.2"
Maximum="5"
AutoToolTipPlacement="None"
AutoToolTipPrecision="1"
TickFrequency="0.1"
IsSnapToTickEnabled="True"
TickPlacement="BottomRight"
Margin="2"
ValueChanged="ShakeMinimumSpeedSlider_OnValueChanged" />
<Label Name="ShakeMinimumSpeedValueLabel" Grid.Column="2" Grid.Row="1"
Content="{Binding ElementName=ShakeMinimumSpeedSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.0}}" Margin="2" />
<Label Grid.Column="3" Grid.Row="1" Content="px/ms" Margin="2" />
<DockPanel
Grid.Column="4"
Grid.Row="1"
Margin="8,4,2,2">
<TextBlock
Text=""
Foreground="{DynamicResource Theme.AccentBlueBrush}"
Visibility="Collapsed"
VerticalAlignment="Top"
Margin="0,0,6,0" />
<TextBlock
Text="Lower is easier to trigger. Higher requires faster movement."
TextWrapping="Wrap"
FontSize="11"
Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />
</DockPanel>
<Label
Grid.Column="0"
Grid.Row="2"
Content="Direction changes"
Margin="2">
<Label.ToolTip>
<ToolTip
Background="#FFFFFFFF"
Foreground="#FF000000"
BorderBrush="#FF767676">
<TextBlock
Text="Lower is easier to trigger. Higher requires more back-and-forth movement."
Foreground="#FF000000"
TextWrapping="Wrap"
MaxWidth="360" />
</ToolTip>
</Label.ToolTip>
</Label>
<Slider
Name="ShakeMinimumTurnsSlider"
Grid.Column="1"
Grid.Row="2"
Width="260"
VerticalAlignment="Center"
Minimum="1"
Maximum="12"
AutoToolTipPlacement="None"
AutoToolTipPrecision="0"
TickFrequency="1"
IsSnapToTickEnabled="True"
TickPlacement="BottomRight"
Margin="2"
ValueChanged="ShakeMinimumTurnsSlider_OnValueChanged" />
<Label Name="ShakeMinimumTurnsValueLabel" Grid.Column="2" Grid.Row="2"
Content="{Binding ElementName=ShakeMinimumTurnsSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" Margin="2" />
<Label Grid.Column="3" Grid.Row="2" Content="turns" Margin="2" />
<DockPanel
Grid.Column="4"
Grid.Row="2"
Margin="8,4,2,2">
<TextBlock
Text=""
Foreground="{DynamicResource Theme.AccentBlueBrush}"
Visibility="Collapsed"
VerticalAlignment="Top"
Margin="0,0,6,0" />
<TextBlock
Text="Lower is easier to trigger. Higher requires more back-and-forth movement."
TextWrapping="Wrap"
FontSize="11"
Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />
</DockPanel>
</Grid>
</Grid>
</TabItem>
<TabItem Header="Hotkey">
<Grid Margin="8">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="130" />
<ColumnDefinition Width="Auto" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
<CheckBox
Name="HotkeyActivationEnabledCheckBox"
Grid.Column="1"
Grid.Row="0"
Grid.ColumnSpan="2"
Content="_Enable hotkey activation"
VerticalAlignment="Center"
Margin="2,2,2,8"
Checked="ActivationSourceCheckBox_OnChanged"
Unchecked="ActivationSourceCheckBox_OnChanged" />
<Grid
Name="HotkeyActivationControlsGrid"
Grid.Column="0"
Grid.Row="1"
Grid.ColumnSpan="3">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="130" />
<ColumnDefinition Width="Auto" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
<Label
Grid.Column="0"
Grid.Row="0"
Content="Mode"
Margin="2" />
<ComboBox
Name="HotkeyActivationModeComboBox"
Grid.Column="1"
Grid.Row="0"
Width="120"
HorizontalAlignment="Left"
Margin="2"
SelectionChanged="HotkeyActivationModeComboBox_OnSelectionChanged" />
<Label
Grid.Column="0"
Grid.Row="1"
Content="Method"
Margin="2" />
<ComboBox
Name="HotkeyActivationMethodComboBox"
Grid.Column="1"
Grid.Row="1"
Grid.ColumnSpan="2"
Width="190"
HorizontalAlignment="Left"
Margin="2"
SelectionChanged="HotkeyActivationMethodComboBox_OnSelectionChanged" />
<Label
Name="HotkeyInputLabel"
Grid.Column="0"
Grid.Row="2"
Content="Shortcut"
Margin="2" />
<StackPanel
Name="HotkeyRecorderPanel"
Grid.Column="1"
Grid.Row="2"
Grid.ColumnSpan="2"
Orientation="Horizontal"
Margin="2">
<TextBox
Name="HotkeyDisplayTextBox"
Width="190"
IsReadOnly="True"
Focusable="True"
VerticalContentAlignment="Center"
Margin="0,0,8,0"
PreviewKeyDown="HotkeyDisplayTextBox_OnPreviewKeyDown"
PreviewKeyUp="HotkeyDisplayTextBox_OnPreviewKeyUp"
LostKeyboardFocus="HotkeyDisplayTextBox_OnLostKeyboardFocus" />
<Button
Name="HotkeyRecordButton"
Content="_Record"
Padding="8,2"
Margin="0,0,6,0"
Click="HotkeyRecordButton_OnClick" />
<Button
Name="HotkeyResetButton"
Content="R_eset"
Padding="8,2"
Click="HotkeyResetButton_OnClick" />
</StackPanel>
<StackPanel
Name="DoubleControlOptionsPanel"
Grid.Column="1"
Grid.Row="2"
Grid.ColumnSpan="2"
Margin="2"
Visibility="Collapsed">
<CheckBox
Name="HotkeyDoubleControlRequireWindowsKeyCheckBox"
Content="Require holding the _Windows key"
Margin="0,0,0,4"
Checked="HotkeyDoubleControlRequireWindowsKeyCheckBox_OnChanged"
Unchecked="HotkeyDoubleControlRequireWindowsKeyCheckBox_OnChanged" />
                            <TextBlock
                                Name="DoubleControlHelpTextBlock"
                                Text="The Ctrl keys are passed through to Windows and other apps. StickyKeys may latch Ctrl, FilterKeys may ignore the second press, and Double Ctrl may also trigger PowerToys or Windows pointer-location effects."
                                TextWrapping="Wrap"
MaxWidth="430"
FontSize="11"
Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />
</StackPanel>
</Grid>
</Grid>
</TabItem>
</TabControl>
</GroupBox>

<DockPanel Grid.Row="3" LastChildFill="False" Margin="0,2,0,0">
<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
<Button
Content="_Reset Defaults"
Margin="0,0,6,0"
Padding="8,2"
Click="ResetDefaultsButton_OnClick" />
</StackPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Vertical" HorizontalAlignment="Right">
<TextBlock
Name="VersionTextBlock"
HorizontalAlignment="Right"
VerticalAlignment="Center"
Foreground="{DynamicResource Theme.SecondaryForegroundBrush}" />
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
<CheckBox
Name="DebugEnabledCheckBox"
Content="Enable _debug logging"
VerticalAlignment="Center"
Margin="0,0,8,0"
Checked="DebugEnabledCheckBox_OnChanged"
Unchecked="DebugEnabledCheckBox_OnChanged" />
<Button
Name="OpenDebugLogButton"
Content="_Open Debug Log"
Padding="8,2"
Click="OpenDebugLogButton_OnClick" />
</StackPanel>
</StackPanel>
</DockPanel>
</Grid>
</Window>
